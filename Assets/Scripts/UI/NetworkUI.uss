.net-root { flex-grow: 1; }
.net-panel {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(10, 10, 14, 0.94);
    align-items: center; justify-content: center;
}
.net-title { font-size: 28px; -unity-font-style: bold; margin: 10px; }
.net-subtitle { font-size: 18px; margin: 6px; }
.net-stats { font-size: 15px; margin: 4px; white-space: normal; }
.net-hint { font-size: 12px; color: rgb(150, 150, 150); margin: 4px; white-space: normal; }
.net-error { font-size: 13px; color: rgb(255, 90, 90); margin: 4px; white-space: normal; }
.net-button { width: 260px; margin: 6px; }
.net-field { width: 260px; margin: 4px; }
.net-hud {
    position: absolute; left: 0; right: 0; top: 0;
    background-color: rgba(0, 0, 0, 0.7); padding: 4px 10px;
    flex-direction: row; align-items: center;
}
.net-hud-item { margin: 2px 10px 2px 0; font-size: 14px; }
.net-hud-quit { width: auto; margin-left: auto; }
.net-overlay {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center; justify-content: center;
}
.net-overlay-card {
    background-color: rgb(30, 30, 36); padding: 20px;
    align-items: center; min-width: 380px;
}
.net-row { flex-direction: row; align-items: center; }
