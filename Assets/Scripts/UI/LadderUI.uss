.ladder-root { flex-grow: 1; }
.ladder-panel {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(10, 10, 14, 0.94);
    align-items: center; justify-content: center;
}
.ladder-title { font-size: 28px; -unity-font-style: bold; margin: 10px; }
.ladder-rank { font-size: 22px; margin: 4px; }
.ladder-stats { font-size: 15px; margin: 4px; white-space: normal; }
.ladder-hint { font-size: 12px; color: rgb(150, 150, 150); margin: 4px; }
.ladder-button { width: 260px; margin: 6px; }
.ladder-hud {
    position: absolute; left: 0; right: 0; top: 0;
    background-color: rgba(0, 0, 0, 0.7); padding: 4px 10px;
    flex-direction: row; align-items: center;
}
.ladder-hud-item { margin: 2px 10px 2px 0; font-size: 14px; }
.ladder-abandon { width: auto; margin-left: auto; }
.ladder-overlay {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center; justify-content: center;
}
.ladder-overlay-card {
    background-color: rgb(30, 30, 36); padding: 20px;
    align-items: center;
}
